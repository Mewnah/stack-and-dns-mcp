# ---------------------------------------------------------------------------
# stack-and-dns-mcp configuration
# The server reads only its environment. Copy this file to .env and load it
# with `npm run start:env` (node --env-file=.env dist/index.js) or
# `docker run --env-file .env`, or export the variables in your process
# manager. With node --env-file, variables already set in the environment take
# precedence; docker run --env-file overrides the image's ENV instead.
# Every value has a safe default and a blank value means "use the default";
# stdio mode needs nothing at all. Active lines show the defaults. The commented
# transport and data-path lines are defaults the Docker image overrides (http,
# /data/...): keep them commented when you use docker run --env-file.
# A value that fails validation stops startup with a message naming it.
# ---------------------------------------------------------------------------

# Transport: stdio (local MCP clients) or http (hosted Streamable HTTP + SSE).
# The --http (aliases --sse, --remote) / --stdio CLI flags override this.
# Default stdio; the Docker image sets http.
# STACKDNS_TRANSPORT=stdio

# --- HTTP transport ----------------------------------------------------------
STACKDNS_HOST=0.0.0.0
STACKDNS_PORT=3333
# PORT=   set by most PaaS; overrides STACKDNS_PORT (--port overrides both).
# Public base URL used in payment challenges and links (no trailing slash).
# Default: http://localhost:<port>.
# STACKDNS_PUBLIC_URL=https://mcp.example.com
# Host header allowlist for DNS-rebinding protection, written exactly as
# clients send the header, port included (localhost:3333,mcp.example.com).
# Without it the protection checks no Host header at all.
STACKDNS_ALLOWED_HOSTS=
# Comma-separated CORS origins. Empty = CORS for any origin on authenticated
# requests; anonymous browser requests (STACKDNS_REQUIRE_AUTH=false) are refused
# unless their origin is listed. "*" allows every origin.
STACKDNS_ALLOWED_ORIGINS=
# The SDK's Host/Origin validation, on the MCP endpoints (/mcp, /sse, /messages)
# only. It checks Host only when STACKDNS_ALLOWED_HOSTS is set (startup warns
# otherwise) and compares origins exactly; a "*" above turns the Origin check off.
STACKDNS_DNS_REBINDING_PROTECTION=false
# Behind a reverse proxy, name the trusted hops so req.ip honours X-Forwarded-For:
# a hop count (1) or a subnet/keyword list (loopback, 10.0.0.0/8). "true" maps to 1.
STACKDNS_TRUST_PROXY=false
# Idle Streamable HTTP session lifetime.
STACKDNS_SESSION_TTL_MS=1800000

# --- Authentication ------------------------------------------------------------
# Require an API key or payment for every request (blank = true for http, false
# for stdio). When false, requests without credentials run as an anonymous
# principal per client address (an IPv6 /64): on the free plan when the server
# sells access (keys, payments or signup), on local otherwise. Browser requests
# from origins not in STACKDNS_ALLOWED_ORIGINS are refused.
STACKDNS_REQUIRE_AUTH=
# Inline keys: key:plan:label,key:plan:label  (plan = free | pro | enterprise)
STACKDNS_API_KEYS=
# Or a JSON file of {id, keyHash, prefix, plan, label, active} records (hashes only).
# A path that does not exist yet is tolerated (logged, zero file-backed keys);
# a file that exists but cannot be parsed is a startup error.
# STACKDNS_API_KEYS_FILE=./keys.json
# Key this stdio process meters tool calls against. It must match a key in
# STACKDNS_API_KEYS / STACKDNS_API_KEYS_FILE set in the same environment and is
# ignored (with a startup warning) when none are set; a stdio server never
# contacts a hosted deployment.
STACKDNS_API_KEY=
# HMAC secret for prepaid session tokens (>=16 chars). Generated per boot if
# unset, which invalidates every token on restart. Keep it fixed, and the same
# for every process sharing the database. Tokens last 30 days.
STACKDNS_SESSION_SECRET=
# Override plan quotas (perMinute / perDay / maxConcurrent tool calls, plus
# httpPerMinute for requests of any kind), e.g.
# {"free":{"perMinute":5,"perDay":50},"pro":{"perDay":10000,"httpPerMinute":600}}
STACKDNS_RATE_LIMITS_JSON=
# Per-client-address ceiling for requests that end before a principal is
# resolved (bad credentials, payment redemption, 402 challenge minting).
STACKDNS_UNAUTHENTICATED_PER_MINUTE=60
# Per-principal usage counters (JSON, written atomically), plus a backup mirror
# of balances. It is the authoritative credit ledger, redeemed-payment list and
# x402 settlement store only when storage is disabled or unavailable; otherwise
# those live in STACKDNS_DB_FILE, the file to persist and back up.
# Use an absolute path when an MCP client starts the server. Default
# ./data/usage.json; the Docker image sets /data/usage.json.
# STACKDNS_USAGE_FILE=./data/usage.json

# --- Storage (stored scans, domain_history, bulk, monitoring, credit ledger) ----
# SQLite database (needs Node.js 22.13+). "none" disables storage-backed tools.
# Use an absolute path when an MCP client starts the server. Default
# ./data/stackdns.db; the Docker image sets /data/stackdns.db.
# STACKDNS_DB_FILE=./data/stackdns.db
# Scans and change-log entries older than this are deleted daily.
STACKDNS_SCAN_RETENTION_DAYS=365

# --- Bulk checks (start_bulk_check and the /v1/jobs REST API) ------------------
STACKDNS_BULK_ENABLED=true
# Distinct domains per job (up to 50000; HTTP body limits grow with it), items
# checked at once (all jobs), unfinished jobs per caller.
STACKDNS_BULK_MAX_DOMAINS=1000
STACKDNS_BULK_CONCURRENCY=4
STACKDNS_BULK_MAX_ACTIVE_JOBS=3
STACKDNS_JOB_RETENTION_DAYS=30

# --- Monitoring (watch_domain, get_alerts, signed webhooks) ---------------------
STACKDNS_MONITOR_ENABLED=true
STACKDNS_MONITOR_INTERVAL_HOURS=24
STACKDNS_MONITOR_CONCURRENCY=2
# Charged to prepaid (payg) watchers per scheduled check; plan keys include watches.
STACKDNS_MONITOR_CREDITS_PER_CHECK=1
# Watched domains per plan, e.g. {"free":5,"pro":100,"enterprise":2000}
STACKDNS_MONITOR_WATCH_LIMITS_JSON=
STACKDNS_ALERT_RETENTION_DAYS=90
# Allow http:// webhook URLs (development only).
STACKDNS_WEBHOOK_ALLOW_INSECURE=false

# --- Reverse lookup (find_domains_using) ---------------------------------------
# A file of domains to crawl (one per line or first CSV column). Unset = the
# reverse-lookup tools are not offered. The crawler honours robots.txt and
# fetches only each homepage.
STACKDNS_CRAWL_SEED_FILE=
STACKDNS_CRAWL_RATE_PER_MINUTE=20
STACKDNS_CRAWL_REFRESH_DAYS=30
STACKDNS_CRAWL_CONCURRENCY=2
# Distinct valid domains taken from the seed file, in file order (up to 5000000).
STACKDNS_CRAWL_MAX_TARGETS=100000

# --- Payments (HTTP 402 challenges) --------------------------------------------
STACKDNS_PAYMENTS_ENABLED=false
# stripe, x402 or both (comma-separated, any case; anything else stops startup).
STACKDNS_PAYMENT_METHODS=stripe
STACKDNS_PAYMENT_CHALLENGE_TTL_MS=900000

# Stripe: price per credit pack in minor units, currency, credits granted.
STRIPE_SECRET_KEY=
STRIPE_PRICE_CENTS=500
STRIPE_CURRENCY=usd
STRIPE_CREDITS_PER_PURCHASE=100
# Optional custom redirect targets for hosted Checkout.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_API_BASE=https://api.stripe.com

# Self-serve API keys: recurring Stripe Prices sold on /signup (needs STRIPE_SECRET_KEY
# and storage). Point a Stripe webhook for customer.subscription.* events at
# <public url>/v1/stripe/webhook and paste its signing secret here.
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_WEBHOOK_SECRET=

# x402 / Machine Payments Protocol: facilitator that verifies + settles.
X402_FACILITATOR_URL=
# Your receiving wallet address.
X402_PAY_TO=
# base, base-sepolia, eip155:8453 and eip155:84532 match in any case and are sent
# in lowercase; any other network id is sent as written (trimmed).
X402_NETWORK=base
# Token contract and its EIP-712 domain (sent as extra.name / extra.version; they
# must equal the contract's name() and version()). Leave all three blank to follow
# X402_NETWORK: USDC 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913, "USD Coin", 2 on
# base; USDC 0x036CbD53842c5426634e7929541eC2318f3dCF7e, "USDC", 2 on base-sepolia.
# On any other network set X402_ASSET and X402_ASSET_NAME, or startup fails when
# x402 is enabled. For another token on base or base-sepolia, set X402_ASSET_NAME too,
# or startup fails when x402 is enabled; set X402_ASSET_VERSION as well if its
# version() is not 2.
X402_ASSET=
X402_ASSET_NAME=
X402_ASSET_VERSION=
# Price in atomic units (500000 = 0.50 USDC).
X402_PRICE_ATOMIC=500000
X402_CREDITS_PER_PAYMENT=100

# --- Inspection ----------------------------------------------------------------
# Per-attempt homepage fetch deadline (500-30000); the insecure-TLS retry and the
# http:// fallback end by twice this.
STACKDNS_FETCH_TIMEOUT_MS=3000
# DNS timeout per try (2 tries per resolver; a failed query may be retried once
# on the other resolvers).
STACKDNS_DNS_TIMEOUT_MS=3000
STACKDNS_TLS_TIMEOUT_MS=3000
STACKDNS_TOOL_TIMEOUT_MS=20000
STACKDNS_MAX_BODY_BYTES=1500000
# Explicit resolvers (comma-separated ip, ipv4:port, [ipv6]:port or [ipv4]:port;
# port 1-65535). Empty = system resolvers.
STACKDNS_DNS_SERVERS=
# Retried per query when the primary fails and preferred for 5 minutes once the
# primary proves unreachable. Set to "none" to disable third-party DNS egress;
# split-horizon deployments should, since public resolvers NXDOMAIN internal zones.
STACKDNS_DNS_FALLBACK_SERVERS=1.1.1.1,8.8.8.8,9.9.9.9
# How long a successful DNS answer (including NXDOMAIN) is reused for identical
# queries within the process; identical in-flight queries are always coalesced.
# 0 disables the cache.
STACKDNS_DNS_CACHE_TTL_MS=30000
STACKDNS_USER_AGENT=Mozilla/5.0 (compatible; StackAndDnsBot/1.0; +https://github.com/Mewnah/stack-and-dns-mcp)
# Allow inspecting hosts that resolve to private / loopback space (dev only).
STACKDNS_ALLOW_PRIVATE_TARGETS=false
# Extra DKIM selectors to probe on every call (comma-separated).
STACKDNS_DKIM_SELECTORS=
# debug | info | warn | error | silent  (always written to stderr; --log-level overrides)
STACKDNS_LOG_LEVEL=info
